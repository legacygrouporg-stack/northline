# Canonical site origin, no trailing slash. Used for OG tags, sitemap, and JSON-LD.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional public address shown on /book
NEXT_PUBLIC_CONTACT_EMAIL=

# Deliver inquiries to a webhook (Zapier / Make / n8n / Slack)
INQUIRY_WEBHOOK_URL=

# Or deliver inquiries by email via Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=
INQUIRY_TO_EMAIL=
